;   /**   * [W_ACK]   * True, when all BRAM writes from S_AXI have completed   * - Set: 'wstate_r' is in IDLE & we have a 'wready_w' but no active 'wvalid'   * - Reset: 'wstate_r' is in W_DATA and there is a 'wvalid'   */   reg s_axi_wready_r;   always @ (posedge aclk)   begin     if (aresetn == 1'b0)       s_axi_wready_r <= 1'b0;     else if (wstate_r == W_IDLE && wready_w && !s_axi_wvalid)       s_axi_wready_r <= 1'b1;     else if (wstate_r == W_DATA && s_axi_wvalid)       s_axi_wready_r <= 1'b0;   end   assign S_AXI_WREADY = s_axi_wready_r;   //  //--------------------------------------------------------------------------   // [B_RESP]   //--------------------------------------------------------------------------   // Write response channel.   //  // s_axi_bvalid_r is set on bvalid_w,   // reset on a master BREADY handshake.   //--------------------------------------------------------------------------   always @ (posedge aclk)   begin     if (aresetn == 1'b0)       s_axi_bvalid_r <= 1'b0;     else if (bvalid_w)       s_axi_bvalid_r <= 1'b1;     else if (S_AXI_BREADY)       s_axi_bvalid_r <= 1'b0;   end   assign S_AXI_BVALID = s_axi_bvalid_r;   assign S_AXI_BRESP  = 2'b00;  // Okay   assign S_AXI_BID    = s_axi_bid_r;      //--------------------------------------------------------------------------   // [R_DATA]   //--------------------------------------------------------------------------   // Read data/response.   //   // s_axi_rvalid_r is set on rvalid_w,   // reset on a master RREADY handshake.   //--------------------------------------------------------------------------   always @ (posedge aclk)   begin     if (aresetn == 1'b0)       s_axi_rvalid_r <= 1'b0;     else if (rvalid_w)       s_axi_rvalid_r <= 1'b1;     else if (S_AXI_RREADY)       s_axi_rvalid_r <= 1'b0;   end   assign S_AXI_RVALID = s_axi_rvalid_r;   assign S_AXI_RRESP  = 2'b00;  // Okay   assign S_AXI_RLAST  = s_axi_rlast_r;   assign S_AXI_RID    = s_axi_rid_r;      //--------------------------------------------------------------------------   // [BRAM Interface]   //--------------------------------------------------------------------------   assign S_OUT_CLK     = aclk;   assign S_OUT_RST     = ~aresetn;   assign S_OUT_EN      = (wstate_r == W_DATA) || (rstate_r == R_DATA);   assign S_OUT_WSTRB   = (wstate_r == W_DATA) ? S_AXI_WSTRB : {S_OUT_WSTRB_W{1'b0}};   assign S_OUT_WDATA   = S_AXI_WDATA;   assign S_OUT_ADDR    = (wstate_r == W_DATA) ? s_axi_awaddr_r[A_WIDTH-1:0] : s_axi_araddr_r[A_WIDTH-1:0];      assign S_AXI_RDATA   = S_OUT_RDATA;      //   // Error Checking   //   // Inject a lint error is C_S_AXI_ADDR_WIDTH != A_WIDTH because   // the upper bits will be lost   generate     if (C_S_AXI_ADDR_WIDTH != A_WIDTH) begin       initial begin         $display(","label":"null","value":"T"},{"category":"label","label":"F","value":"F"},{"category":"label","label":"T","value":"T"},{"category":"label","label":"F","value":"F"},{"category":"label","label":"F","value":"F"},{"category":"label","label":"F","value":"F"},{"category":"label","label":"T","value":"T"},{"category":"label","label":"F","value":"F"},{"category":"label","label":"T","value":"T"},{"category":"label","label":"F","value":"F"},{"category":"label","label":"F","value":"F"},{"category":"label","label":"T","value":"T"},{"category":"label","label":"F","value":"F"},{"category":"label","label":"F","value":"F"},{"category":"label","label":"F","value":"F"},{"category":"label","label":"F","value":"F"},{"category":"label","label":"F","value":"F"},{"category":"label","label":"T","value":"T"},{"category":"label","label":"F","value":"F"},{"category":"label","label":"F","value":"F"},{"category":"label","label":"T","value":"T"},{"category":"label","label":"T","value":"T"},{"category":"label","label":"T","value":"T"},{"category":"label","label":"F","value":"F"},{"category":"label","label":"F","value":"F"},{"category":"label","label":"F","value":"F"},{"category":"label","label":"T","value":"T"},{"category":"labe